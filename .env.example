# WikiRacer talks to the LLM through the Anthropic Python SDK, so any
# Anthropic-compatible provider works (Anthropic itself, DeepSeek, etc.).
# Change LLM_BASE_URL and the model IDs to switch providers. Empty model
# values keep the Claude defaults (Haiku / Haiku / Sonnet).
#
# Anthropic:
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_EASY_MODEL=claude-haiku-4-5
#   LLM_MEDIUM_MODEL=claude-haiku-4-5
#   LLM_HARD_MODEL=claude-sonnet-5
#
# DeepSeek (Anthropic-compatible endpoint):
#   LLM_API_KEY=...
#   LLM_BASE_URL=https://api.deepseek.com/anthropic
#   LLM_EASY_MODEL=deepseek-chat
#   LLM_MEDIUM_MODEL=deepseek-chat
#   LLM_HARD_MODEL=deepseek-reasoner
#
# ANTHROPIC_API_KEY is still read if LLM_API_KEY is empty, so an existing
# local .env keeps working.

LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_EASY_MODEL=
LLM_MEDIUM_MODEL=
LLM_HARD_MODEL=

# Steel resolves its own credentials via `steel login`.
# In Docker, set STEEL_API_KEY instead (the CLI reads it from the environment).
# See PLAN.md 4.E: do NOT add a hard STEEL_API_KEY check to config.py.
STEEL_API_KEY=
